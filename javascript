<!DOCTYPE html>
<html>
    <head>
        <title>JavaScript</title>
    </head>
    <body>
        <h4>JavaScript</h4>
        <script>
            let mawsim = prompt("birewin tanlan (jasil, sari, qizil)")
            if (mawsim ==="jasil"){
                console.log("Jurin")
            } else if(mawsim ==="sari"){
                console.log("Tayarlanin")
            } else if(mawsim ==="qizil"){
                console.log("Toxtan!")
            } else{
                console.log("(jasil, sari, qizil)birewin kiritpediniz!")
            }
        </script>
    </body>
</html>
